rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // 共通認可・判定関数
    // =========================================================================

    // 【認証状態判定】Firebase Auth による認証トークンが存在するか判定
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // 【Auth UID 本人判定】指定された UID が現在ログイン中の Firebase Auth UID と一致するか判定
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 【テナント所属ユーザー本人検証】
    // 指定された userId (u_...) のプロファイルが指定テナントに存在し、
    // かつそのプロファイル内の uid が現在ログイン中の Auth UID と一致している（本人である）かを検証
    function isTenantUser(tenantId, userId) {
      let userPath = /databases/$(database)/documents/tenants/$(tenantId)/users/$(userId);
      return isAuthenticated()
        && userId != null
        && exists(userPath)
        && get(userPath).data.uid == request.auth.uid;
    }

    // 【監査メタデータ作成時検証】
    // 作成時に createdBy, createdAt, updatedBy, updatedAt が必ず含まれ、
    // createdBy, updatedBy が操作者本人の正当な userId (u_...) であり、作成時は両者が一致し、
    // createdAt, updatedAt がリクエスト実行時のサーバー現在時刻 (request.time) であることを検証
    function isValidAuditCreate(tenantId) {
      return request.resource.data.keys().hasAll(['createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
        && isTenantUser(tenantId, request.resource.data.createdBy)
        && request.resource.data.createdBy == request.resource.data.updatedBy
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    // 【監査メタデータ更新時検証】
    // 更新時に createdBy, createdAt は一切変更（更新）されず、
    // updatedBy, updatedAt が必ず含まれ、updatedBy が更新操作者本人の userId (u_...) であり、
    // updatedAt がリクエスト実行時のサーバー現在時刻 (request.time) であることを検証
    function isValidAuditUpdate(tenantId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'createdAt'])
        && request.resource.data.keys().hasAll(['updatedBy', 'updatedAt'])
        && isTenantUser(tenantId, request.resource.data.updatedBy)
        && request.resource.data.updatedAt == request.time;
    }

    // 【チャット正当メンバー判定】
    // チャットが存在し、かつ現在ログイン中のユーザーがそのチャットの正当な参加メンバーであるかを判定
    function isChatMember(tenantId, chatId) {
      let chatPath = /databases/$(database)/documents/tenants/$(tenantId)/chats/$(chatId);

      return isAuthenticated()
        && (
      // ケース1: 既存チャットドキュメントが存在する場合
      (
      exists(chatPath)
        && (
      // 1) 1:1 ダイレクトメッセージ (DM) の場合:
      (
      get(chatPath).data.chatType == 'direct'
        && (
      !('members' in get(chatPath).data)
        || get(chatPath).data.members.size() != 2
        || isTenantUser(tenantId, get(chatPath).data.members[0])
        || isTenantUser(tenantId, get(chatPath).data.members[1])
      )
      )
        ||
      // 2) グループチャットの場合:
      (get(chatPath).data.chatType == 'group')
      )
      )
        ||
      // ケース2: 親チャットドキュメント未作成時 (DM チャットID dm_u_A_u_B の形式)
      // クライアントが画面を開いた直後・親ドキュメント作成前の先行メッセージリッスンを許可
      (
      chatId.matches('^dm_[a-zA-Z0-9_]+$')
      )
      );
    }

    // 【グループチャット オーナーまたは管理者判定】
    // 指定されたチャットの memberRoles において、操作者が owner または admin であるかを判定
    function isGroupOwnerOrAdmin(chatData, operatorUserId) {
      return chatData.chatType == 'group'
        && (
      ('memberRoles' in chatData && (chatData.memberRoles[operatorUserId] == 'owner' || chatData.memberRoles[operatorUserId] == 'admin'))
        ||
      (chatData.createdBy == operatorUserId)
      );
    }

    // =========================================================================
    // 1. 全域ユーザー情報 (/users/{uid})
    //    - ユーザーの E2EE 公開鍵 (publicKey) やデフォルト所属テナント等を管理
    // =========================================================================
    match /users/{uid} {
      // 公開情報 (公開鍵, デフォルトテナントID等) は認証済みユーザー全員に読み取り許可
      allow read: if isAuthenticated();

      // 新規作成・更新は本人のみ可能 (Auth UID の一致を強制)
      allow create, update: if isUser(uid)
        && request.resource.data.uid == uid
        && (!('publicKey' in request.resource.data) || request.resource.data.publicKey is string);

      // アカウント情報の物理削除は本人のみ可能 (退会・データ抹消)
      allow delete: if isUser(uid);

      // 【本人専用領域】秘密鍵のバックアップ・復元データ (/users/{uid}/private/data)
      match /private/data {
        // 秘密鍵復元: 本人のみ読み取り許可
        allow read: if isUser(uid);

        // バックアップ登録・更新: 本人のみ、かつスキーマ・サイズ・型を厳格検証
        allow create, update: if isUser(uid)
          && request.resource.data.uid == uid
          && request.resource.data.recoveryHash is string
          && request.resource.data.recoveryHash.size() == 64
          && request.resource.data.encryptedPrivateKey is string
          && request.resource.data.encryptedPrivateKey.size() > 0
          && request.resource.data.encryptedPrivateKey.size() < 2048
          && request.resource.data.nonce is string
          && request.resource.data.nonce.size() > 0
          && request.resource.data.nonce.size() < 128;

        // 復元データの物理削除は本人のみ可能 (退会・データ抹消)
        allow delete: if isUser(uid);
      }
    }

    // =========================================================================
    // 1.1 端末復元ボルト (/recovery_vault/{recoveryHash})
    //     - 未ログイン端末から「ふっかつのじゅもん」による完全アカウント復旧を行うための保管庫
    //     - クライアント直接読み取りは禁止（Cloudflare Workers バックエンド経由で安全に照合）
    // =========================================================================
    match /recovery_vault/{recoveryHash} {
      // クライアントからの直接読み取りは完全禁止 (Cloudflare Workers サーバーが Admin 権限で照合)
      allow read: if false;

      // バックアップ登録・更新: 本人の uid と一致すること、および厳格なバリデーション
      allow create, update: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.recoveryHash == recoveryHash
        && recoveryHash.size() == 64
        && request.resource.data.encryptedPrivateKey is string
        && request.resource.data.encryptedPrivateKey.size() > 0
        && request.resource.data.encryptedPrivateKey.size() < 2048
        && request.resource.data.nonce is string
        && request.resource.data.nonce.size() > 0
        && request.resource.data.nonce.size() < 128;

      // じゅもん再作成時の旧ハッシュ削除: ドキュメント所有者本人のみ許可
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // =========================================================================
    // 2. テナントコレクション (/tenants/{tenantId})
    //    - 組織・企業・コミュニティ単位のデータ境界
    // =========================================================================
    match /tenants/{tenantId} {
      // テナント情報 (tenantCode, 暗号化テナント名等) はログイン前・テナント選択時にも読み取り許可
      allow read: if true;

      // テナント本体の書き込み・変更・削除はクライアント SDK から完全禁止 (サーバー管理)
      allow write: if false;

      // -----------------------------------------------------------------------
      // 2.1 テナント内ユーザープロファイル (/tenants/{tenantId}/users/{userId})
      // -----------------------------------------------------------------------
      match /users/{userId} {
        // 公開プロファイル (publicKey, username等) は単一取得 (get) を許可
        // 一覧取得 (list) は自身のプロファイル検索 (resource.data.uid == request.auth.uid) のみ許可（名簿スクレイピング・全件スキャン防止）
        allow get: if isAuthenticated();
        allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;

        // 新規作成: 自身が所有者 (uid == request.auth.uid) としてのみ新規作成可能
        // 作成監査メタデータ (createdBy/createdAt/updatedBy/updatedAt) の整合性を強制
        allow create: if isAuthenticated()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.tenantId == tenantId
          && request.resource.data.userId == userId
          && request.resource.data.createdBy == userId
          && request.resource.data.updatedBy == userId
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.keys().hasAll(['createdBy', 'createdAt', 'updatedBy', 'updatedAt']);

        // プロファイル更新: 既存ドキュメントの所有者本人のみ許可
        // 作成時メタデータの不変性 (createdBy/createdAt) と更新者 (updatedBy) の正当性を検証
        allow update: if isAuthenticated()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.tenantId == tenantId
          && request.resource.data.userId == userId
          && isValidAuditUpdate(tenantId);

        // ユーザープロファイルの削除は本人のみ可能 (退会・データ抹消)
        allow delete: if isTenantUser(tenantId, userId);

        // ---------------------------------------------------------------------
        // 2.1.1 友達サブコレクション (/tenants/{tenantId}/users/{userId}/friends/{friendUserId})
        // ---------------------------------------------------------------------
        match /friends/{friendUserId} {
          // 自分の友達リストのみ閲覧可能
          allow read: if isTenantUser(tenantId, userId);

          // 友達追加・相互登録時の書き込み:
          // 作成監査メタデータが正当であり、操作者が当事者であることを検証
          allow create: if isAuthenticated()
            && request.resource.data.tenantId == tenantId
            && isValidAuditCreate(tenantId)
            && (
          (isTenantUser(tenantId, userId) && request.resource.data.createdBy == userId) ||
          (isTenantUser(tenantId, friendUserId) && request.resource.data.createdBy == friendUserId)
          );

          // 友達情報更新時:
          allow update: if isAuthenticated()
            && request.resource.data.tenantId == tenantId
            && isValidAuditUpdate(tenantId)
            && (
          isTenantUser(tenantId, userId) ||
          isTenantUser(tenantId, friendUserId)
          );

          // 友達の解除・削除は自分の友達リストからのみ可能
          allow delete: if isTenantUser(tenantId, userId);
        }
      }

      // -----------------------------------------------------------------------
      // 2.2 ユーザー名一意性インデックス (/tenants/{tenantId}/usernames/{username})
      //     - ドキュメント ID に小文字 username を使用し、重複登録を排他ロック
      // -----------------------------------------------------------------------
      match /usernames/{username} {
        // ユーザー名重複確認・ピンポイント検索のみ許可 (get)。全件一覧取得 (list) は完全禁止
        allow get: if isAuthenticated();
        allow list: if false;

        // 新規登録: 自分の uid を紐付け、まだ存在しない場合のみ作成可能
        // ※ 新規ユーザー作成時は /users/{userId} と同一バッチで同時作成されるため、exists() を要する isTenantUser ではなく直接整合性を検証
        allow create: if isAuthenticated()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.tenantId == tenantId
            && username.matches('^[a-zA-Z0-9_]{3,32}$')
          && request.resource.data.keys().hasAll(['userId', 'uid', 'tenantId', 'createdBy', 'createdAt', 'updatedBy', 'updatedAt'])
          && request.resource.data.createdBy == request.resource.data.userId
          && request.resource.data.updatedBy == request.resource.data.userId
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        // ユーザー名変更・登録において上書き・改ざん・乗っ取りを防ぐため update は完全禁止
        // 変更時は「新ドキュメントの新規作成 (create)」＋「旧ドキュメントの削除 (delete)」を行う
        allow update: if false;

        // 旧インデックスの削除・解放: 所有者本人のみ許可
        allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
      }

      // -----------------------------------------------------------------------
      // 2.3 チャット・会話コレクション (/tenants/{tenantId}/chats/{chatId})
      // -----------------------------------------------------------------------
      match /chats/{chatId} {
        // 単一取得 (get): チャット参加メンバーまたは未作成ドキュメントの存在確認を許可
        allow get: if isAuthenticated() && (resource == null || isChatMember(tenantId, chatId));

        // 一覧取得 (list): 認証済みユーザーにクエリを許可 (クライアントクエリ members array-contains による制御)
        allow list: if isAuthenticated();

        // 新規チャット作成 (Create):
        // 監査メタデータの正当性 (createdBy/createdAt/updatedBy/updatedAt) を検証
        allow create: if isAuthenticated()
          && request.resource.data.tenantId == tenantId
          && isValidAuditCreate(tenantId)
          && (
        // 1:1 DM の場合: 2名構成でソートされ、自身が含まれていること
        (
        request.resource.data.chatType == 'direct'
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] < request.resource.data.members[1]
          && (
        request.resource.data.createdBy == request.resource.data.members[0] ||
        request.resource.data.createdBy == request.resource.data.members[1]
        )
        )
          ||
        // グループチャットの場合: 参加者が1名以上存在し、作成者が members に含まれていること
        (
        request.resource.data.chatType == 'group'
          && request.resource.data.members.size() > 0
          && request.resource.data.createdBy in request.resource.data.members
        )
        );

        // メタデータ更新 (Update):
        // 作成時メタデータの不変性 (createdBy/createdAt) と更新者 (updatedBy) の正当性を検証
        allow update: if isAuthenticated()
          && request.resource.data.tenantId == tenantId
          && isValidAuditUpdate(tenantId)
          && (
        (
        isChatMember(tenantId, chatId)
          && (
        !('members' in request.resource.data) ||
        !('members' in resource.data) ||
        request.resource.data.members == resource.data.members ||
        (
        resource.data.chatType == 'group'
          && (
        // 通常更新 (メンバー追加、ロール変更、最新メッセージ更新、本人の自発的退出、または管理者・オーナーによる他者退出操作)
        (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'members', 'memberRoles', 'latestKeyVersion', 'lastMessage', 'lastMessageAt', 'updatedBy', 'updatedAt'
        ])
          && (
        // メンバーが減っていない (追加、ロール変更、メッセージ更新)
        request.resource.data.members.size() >= resource.data.members.size()
          ||
        // オーナーまたは管理者による他人の退出操作
        isGroupOwnerOrAdmin(resource.data, request.resource.data.updatedBy)
          ||
        // 本人の自発的退出 (除外されたのが updatedBy 本人のみ)
        (
        !(request.resource.data.updatedBy in request.resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() - 1
        )
        )
        )
          ||
        // グループ名変更 (title更新) -> オーナーまたは管理者のみ実行可能
        (
        isGroupOwnerOrAdmin(resource.data, request.resource.data.updatedBy)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'title', 'updatedBy', 'updatedAt'
        ])
        )
          ||
        // グループ削除 (membersクリア & isDeleted: true) -> オーナーまたは管理者のみ実行可能
        (
        isGroupOwnerOrAdmin(resource.data, request.resource.data.updatedBy)
          && request.resource.data.members.size() == 0
          && request.resource.data.isDeleted == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'members', 'isDeleted', 'deletedBy', 'deletedAt', 'updatedBy', 'updatedAt'
        ])
        )
        )
        )
        )
        )
          ||
        (
        request.resource.data.chatType == 'direct'
          && request.resource.data.members.size() == 2
          && request.resource.data.members[0] < request.resource.data.members[1]
          && (
        isTenantUser(tenantId, request.resource.data.members[0]) ||
        isTenantUser(tenantId, request.resource.data.members[1])
        )
        )
        );

        // チャット親ドキュメントの削除は禁止
        allow delete: if false;

        // ---------------------------------------------------------------------
        // 2.3.1 暗号化メッセージ (/tenants/{tenantId}/chats/{chatId}/messages/{messageId})
        // ---------------------------------------------------------------------
        match /messages/{messageId} {
          // チャット参加メンバーのみメッセージを読み取り可能
          allow read: if isChatMember(tenantId, chatId);

          // メッセージ作成: クライアント SDK からの直接書き込みは完全禁止 (Cloudflare Workers API が Admin 権限で保存)
          allow create: if false;

          // メッセージ本文の改ざん・削除は禁止、リアクション集計と監査更新 (updatedBy/updatedAt) のみ更新許可
          allow update: if isChatMember(tenantId, chatId)
            && isValidAuditUpdate(tenantId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCounts', 'updatedBy', 'updatedAt']);

          allow delete: if false;

          // -------------------------------------------------------------------
          // 2.3.1.1 メッセージリアクション (/reactions/{reactionUserId})
          // -------------------------------------------------------------------
          match /reactions/{reactionUserId} {
            // チャット参加メンバーのみリアクション状況を閲覧可能
            allow read: if isChatMember(tenantId, chatId);

            // 自分のリアクションのみ作成可能 (reactionUserId == createdBy)
            allow create: if isAuthenticated()
              && isChatMember(tenantId, chatId)
              && isValidAuditCreate(tenantId)
              && (reactionUserId == request.resource.data.createdBy)
              && (request.resource.data.userId == request.resource.data.createdBy)
              && request.resource.data.chatId == chatId
              && request.resource.data.tenantId == tenantId;

            // 自分のリアクションのみ更新可能
            allow update: if isAuthenticated()
              && isChatMember(tenantId, chatId)
              && isValidAuditUpdate(tenantId)
              && (reactionUserId == request.resource.data.updatedBy)
              && (request.resource.data.userId == request.resource.data.updatedBy)
              && request.resource.data.chatId == chatId
              && request.resource.data.tenantId == tenantId;

            // 自分のリアクションのみ削除・解除可能
            allow delete: if isAuthenticated()
              && isChatMember(tenantId, chatId)
              && isTenantUser(tenantId, reactionUserId);
          }
        }

        // ---------------------------------------------------------------------
        // 2.3.2 既読管理カーソル (/tenants/{tenantId}/chats/{chatId}/receipts/{receiptUserId})
        // ---------------------------------------------------------------------
        match /receipts/{receiptUserId} {
          // チャット参加メンバーは他メンバーの既読水位線カーソルを読み取り可能
          allow read: if isChatMember(tenantId, chatId);

          // 自分の既読カーソルのみ作成可能
          allow create: if isAuthenticated()
            && isChatMember(tenantId, chatId)
            && isValidAuditCreate(tenantId)
            && (receiptUserId == request.resource.data.createdBy)
            && (request.resource.data.userId == request.resource.data.createdBy)
            && request.resource.data.chatId == chatId
            && request.resource.data.tenantId == tenantId;

          // 自分の既読カーソルのみ更新可能
          allow update: if isAuthenticated()
            && isChatMember(tenantId, chatId)
            && isValidAuditUpdate(tenantId)
            && (receiptUserId == request.resource.data.updatedBy)
            && (request.resource.data.userId == request.resource.data.updatedBy)
            && request.resource.data.chatId == chatId
            && request.resource.data.tenantId == tenantId;

          allow delete: if false;
        }

        // ---------------------------------------------------------------------
        // 2.3.3 会話共通鍵バケット (/tenants/{tenantId}/chats/{chatId}/keys/{keyVersion})
        // ---------------------------------------------------------------------
        match /keys/{keyVersion} {
          // チャット参加メンバーのみ暗号化鍵バケットを読み取り可能
          allow read: if isChatMember(tenantId, chatId);

          // チャット参加メンバーのみ新規鍵バケット (v_1, v_2...) を作成可能
          allow create: if isAuthenticated()
            && isChatMember(tenantId, chatId)
            && isValidAuditCreate(tenantId)
            && request.resource.data.tenantId == tenantId
            && request.resource.data.chatId == chatId;

          // 既存の鍵バケットの上書き・削除は禁止 (Forward Secrecy 担保)
          allow update, delete: if false;
        }
      }
    }
  }
}
